# ============================================
# Application Configuration
# ============================================

NODE_ENV=development

# Frontend URL (Next.js)
NEXT_PUBLIC_URL=http://localhost:3006
NEXT_PUBLIC_APP_URL=http://localhost:3006

# NestJS backend API URL (required when mocks are off)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Mock vs live integration (single switch)
# ============================================
# true  (default) — in-memory mocks; no NestJS / Django required
# false           — live NestJS auth + REST + vendor-core intake API
NEXT_PUBLIC_USE_MOCK=true

# ABAC role override for local UI gating (optional)
NEXT_PUBLIC_DEV_ADMIN=true
# NEXT_PUBLIC_DEV_MANAGER=true
# NEXT_PUBLIC_DEV_VENDOR=true

# ============================================
# Vendor Management Core (Django intake API)
# ============================================
# Used automatically when NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_VENDOR_CORE_API_URL=http://localhost:8010

# Set automatically by pnpm test:e2e (do not enable in production)
# NEXT_PUBLIC_E2E=true
