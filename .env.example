# ============================================
# Application Configuration
# ============================================

NODE_ENV=development

# Frontend URL (Next.js)
NEXT_PUBLIC_URL=http://localhost:3006
NEXT_PUBLIC_APP_URL=http://localhost:3006

# NestJS backend API URL (only when mocks are off)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# Mock-only mode (default — no NestJS required)
# ============================================

NEXT_PUBLIC_USE_MOCK_AUTH=true
NEXT_PUBLIC_USE_MOCK_VMS=true
NEXT_PUBLIC_USE_MOCK_GROUPS=true
NEXT_PUBLIC_USE_MOCK_USERS=true
NEXT_PUBLIC_USE_MOCK_ROLES=true
NEXT_PUBLIC_USE_MOCK_SETTINGS=true
NEXT_PUBLIC_DEV_ADMIN=true

# Set NEXT_PUBLIC_USE_MOCK_AUTH=false to use real Better Auth against NestJS
# NEXT_PUBLIC_DEV_MANAGER=true
# NEXT_PUBLIC_DEV_VENDOR=true

# Set automatically by pnpm test:e2e (do not enable in production)
# NEXT_PUBLIC_E2E=true
